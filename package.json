{
  "name": "little-nature",
  "version": "1.0.0",
  "private": true,
  "main": "index.ts",
  "scripts": {
    "start": "expo start --offline",
    "android": "expo start --android --offline",
    "ios": "expo start --ios --offline",
    "web": "expo start --web --offline",
    "typecheck": "tsc --noEmit",
    "export:web": "expo export --platform web",
    "export:pages": "node scripts/export-pages.mjs",
    "export:all": "expo export --platform all",
    "test:smoke": "python3 scripts/smoke_test.py",
    "generate:audio": "python3 scripts/generate_audio.py"
  },
  "dependencies": {
    "@expo-google-fonts/lora": "^0.4.2",
    "@expo-google-fonts/nunito": "^0.4.2",
    "expo": "~58.0.17",
    "expo-audio": "~58.0.10",
    "expo-font": "~58.0.9",
    "expo-speech": "~58.0.3",
    "expo-status-bar": "~58.0.4",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-native": "0.88.0",
    "react-native-safe-area-context": "~5.10.1",
    "react-native-svg": "15.16.0",
    "react-native-web": "~0.21.4"
  },
  "devDependencies": {
    "@types/react": "~19.3.0",
    "typescript": "~6.0.3"
  }
}
